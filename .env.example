# NFT Public Mint — optional configuration
# Everything here is OPTIONAL. The wizard asks for what it needs and these
# values just become the pre-filled defaults.
#
# Copy to .env:   cp .env.example .env
#
# NEVER put private keys in this file. Keys are pasted into the CLI at run
# time, held in memory only, and never written to disk.

# --- RPC endpoints (recommended) ---
# A private RPC is the single biggest factor in whether you win a contested
# mint. Public nodes work but are slower and rate-limited.
# One entry per chain you mint on. You can also paste these at the prompt.
RPC_URL_ETHEREUM=
RPC_URL_BASE=
RPC_URL_ROBINHOOD=

# --- Default chain highlighted in the menu ---
# ethereum | base | robinhood  (short aliases eth | robin also accepted)
CHAIN=ethereum

# --- Gas defaults (gwei) ---
# Pre-filled at the prompt; you confirm or change them on every run.
# The max fee is a CEILING, not what you pay — you pay base fee + tip. But note
# a node reserves gasLimit × maxFee upfront, so the wallet must hold that much.
MAX_FEE_PER_GAS=
MAX_PRIORITY_FEE=

# Gas limit per mint tx. A SeaDrop mint uses roughly 135k for quantity 1.
GAS_LIMIT=

# --- OpenSea REST API key (optional) ---
# ONLY used to turn a collection slug into a contract address. Pasting the 0x
# contract address always works and needs nothing here. The mint itself never
# contacts OpenSea.
# Free key: https://docs.opensea.io/reference/api-keys
OPENSEA_API_KEY=

# --- Telegram bot (optional) ---
# Run `npm start -- --telegram` to mint from Telegram.
# Get a token from @BotFather. ALLOWED_CHAT_ID restricts who can trigger mints
# (comma-separated Telegram user/chat ids). Leave ALLOWED_CHAT_ID empty to allow
# any chat that messages the bot (not recommended).
TELEGRAM_BOT_TOKEN=
ALLOWED_CHAT_ID=
